# Mapbox Access Token
# Get from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps API Keys
# Get from: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API (for 3D maps), Places API (for POI details)
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (for migration script and admin operations)
# WARNING: Never expose this key in the browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production board assistant. The service listens on loopback; only Next calls it.
OPENAI_API_KEY=
ANJA_SERVICE_URL=http://127.0.0.1:8787
ANJA_SERVICE_SECRET=replace-with-a-long-random-service-secret
ANJA_CAPABILITY_SECRET=replace-with-a-separate-random-cookie-secret-at-least-32-chars
ANJA_SERVICE_PORT=8787
ANJA_SESSION_MAX_MS=900000
ANJA_MAX_CONCURRENT=20
ANJA_STARTS_PER_HOUR=600
