    "global": {
      "faq": [
        {
          "id": "karakteristikk",
          "spørsmål": "Hva kjennetegner området?",
          "svar": "Nyhavna og Lademoen ligger øst for Nidelvas utløp, mellom jernbanen og Ladehammeren, med Strandveien som ryggrad. Nyhavna er havne- og industriområdet som bygges om til bydel, mens Lademoen og Lilleby er etablerte boligkvartaler med egen barneskole, park og kirke — og Ladestien og fjorden begynner der kvartalene slutter."
        }
      ]
